<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Requested at runtime, behind the consent screen (see the plan's own
         Phase 3 notes); declared here only. NOT the default SMS app: these
         three permissions are enough to send, read the existing content://sms
         provider, and receive new incoming SMS, without implementing the
         SmsProvider-compatible UI components the default-handler role needs. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Same artwork as the Windows app's own icon (Windows/Caroline/
         Resources/app.ico), sourced from the marketing site's higher-res
         copy (caroline-site/assets/img/brand/icon-512.webp, same image) for
         better downscaling quality. mipmap-anydpi-v26/ic_launcher(_round).xml
         supplies the adaptive-icon version; the mipmap-*dpi PNGs are the
         legacy fallback for API <26. -->
    <application
        android:name=".CompanionApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.CarolineCompanion"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CarolineCompanion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Opt-in only (CompanionSetupScreen); see its own doc comment for
             why this isn't auto-started. No SmsReceiver: every companion_*
             tool is a pull (Caroline asks, phone answers from the current
             content://sms state), nothing needs a push on new-incoming-SMS. -->
        <service
            android:name=".service.CompanionOpsService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
