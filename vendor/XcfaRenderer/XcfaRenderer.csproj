<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Default SDK glob would otherwise also pick up XcfaRenderer.Tests/*.cs and Demo/*.cs as part of THIS project. -->
    <Compile Remove="XcfaRenderer.Tests\**\*.cs" />
    <Compile Remove="Demo\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XcfaRenderer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
  </ItemGroup>

</Project>
