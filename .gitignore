# --- Visual Mode talking-head models --------------------------------------
# Tens of GB each -- too large to keep in git, and the app doesn't need them
# in the checkout anyway (ModelsInstaller downloads them straight from the
# release server at install time). Kept locally for dev/testing only.
art/models/*.xcfa
art/models/*.cfa

# --- Python ----------------------------------------------------------------
art/__pycache__/
**/__pycache__/

# --- Deploy tooling / secrets (maintainer-only, never public) --------------
# deploy.mk committed 2026-10-18 (contains no secret -- the bearer token
# lives in deploy_token.txt, outside this repo entirely, never committed
# here). deploy.bat/deploy_models.bat are the superseded pre-deploy.mk
# scripts (see deploy.mk's own header) and stay ignored as dead local files.
deploy.bat
deploy_models.bat
install-local.ps1

# --- backend-py (Python backend) --------------------------------------------
# Real SquirrelWisdom/Camerlengo service keys for this machine's build --
# see sw_service_keys_example.py's docstring (2026-10 public-key-exposure
# incident). Never commit this file; sw_service_keys_example.py is the
# committed template.
backend-py/app/sw_service_keys_local.py
# Local copy of Caroline's own bundled embeddable Python runtime + every pip
# dependency installed into it -- the Python equivalent of backend/node_modules/,
# same reasoning: huge, regenerable, never meant to ship in the repo itself.
backend-py/python-runtime/
# Isolated per-tab state (schedule.json, session ids, dehydrated transcripts,
# etc.) from ad-hoc plugin/engine testing against an explicit
# CAROLINE_WORKSPACE_DIR override -- never the real user's workspace, but
# still not repo content.
backend-py/test-workspace/
# Throwaway Phase-1 WS round-trip verification script -- not a real test
# suite.
backend-py/test_roundtrip.py

# --- Misc build/debug artifacts --------------------------------------------
*.log

# Local, never in this public repository: the Linux build output (like dist/),
# and paper drafts (a named version would break double-blind review).
dist-linux/
Claude outputs/
