# --- Visual Mode talking-head models --------------------------------------
# Tens of GB each -- too large to keep in git, and the app doesn't need them
# in the checkout anyway (ModelsInstaller downloads them straight from the
# release server at install time). Kept locally for dev/testing only.
art/models/*.xcfa
art/models/*.cfa

# --- Python ----------------------------------------------------------------
art/__pycache__/
**/__pycache__/

# --- Deploy tooling / secrets (maintainer-only, never public) --------------
# See deploy.mk's own header comment: split out of the public Makefile,
# gitignored the same as these two scripts always were.
deploy.bat
deploy_models.bat
deploy.mk

# --- Misc build/debug artifacts --------------------------------------------
*.log
