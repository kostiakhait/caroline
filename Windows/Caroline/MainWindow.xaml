<Window x:Class="Caroline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caroline"
        Width="420" Height="640"
        MinWidth="320" MinHeight="400"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <Grid Background="#5066C9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom tab strip (not a WPF TabControl: chat.html already renders its
             own toolbar/settings gear per tab; a native TabControl's own chrome
             would just add a second, visually inconsistent header on top of that).
             Populated in code-behind by RebuildTabStrip(). -->
        <StackPanel x:Name="TabStrip" Grid.Row="0" Orientation="Horizontal"
                    Background="#3A3F8F" Visibility="Collapsed" />

        <Grid Grid.Row="1" x:Name="TabContentHost" />

        <!-- Startup progress is shown by the floating SplashWindow instead;
             this only appears if something actually goes wrong (no Node.js,
             WebView2 Runtime missing, etc.). -->
        <Border x:Name="Splash" Grid.Row="0" Grid.RowSpan="2" Background="#5066C9" Visibility="Collapsed">
            <TextBlock x:Name="SplashText" Foreground="White" FontSize="14"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI" />
        </Border>
    </Grid>
</Window>
