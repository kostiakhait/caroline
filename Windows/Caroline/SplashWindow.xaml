<Window x:Class="Caroline.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caroline"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Width="480" Height="320"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Rounded corners, per explicit ask: a Border filled with an
             ImageBrush clips to CornerRadius natively (a plain Image
             element has no corner-radius concept of its own). -->
        <Border x:Name="PhotoBorder" Width="480" Height="270" CornerRadius="18">
            <Border.Background>
                <ImageBrush x:Name="PhotoBrush" Stretch="UniformToFill" />
            </Border.Background>
        </Border>
        <TextBlock x:Name="ConnectingText" Text="Connecting..." Foreground="White" FontSize="16"
                   FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,12,0,0">
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
            </TextBlock.Effect>
        </TextBlock>
    </StackPanel>
</Window>
