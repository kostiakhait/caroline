<Window x:Class="Caroline.VisualModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caroline"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Width="260" Height="320">
    <Grid>
        <!-- Bottom margin reserves room for ControlsBar below. Without it, the model
             image/video (fills 100% of WebViewHost, see visualmode.html's own CSS)
             rendered all the way to the window's bottom edge, under the button bar,
             instead of leaving room above it. Confirmed live (2026-09-03) once the
             window actually started rendering for the first time (fixed separately,
             see VisualModeManager.HandleStartAsync's Show before Init ordering fix).
             object-fit:contain in visualmode.html's CSS means the image/video just
             scales down to fit the smaller area, no other change needed there. -->
        <Grid x:Name="WebViewHost" Margin="0,0,0,36" />

        <!-- Small semi-opaque control bar, bottom-center: same three actions
             (pause/restart/stop) as the main chat window's own voice playback
             bar, just native buttons here instead of HTML (see chat.js's
             voiceControls for the visual/behavioral reference). Per explicit
             instruction (2026-09-03): smaller, rounded, and ControlsBar itself
             is toggled Collapsed for clips under ControlsMinDurationSeconds (see
             VisualModeWindow.xaml.cs's "duration" message handling), not shown here. -->
        <Border x:Name="ControlsBar" VerticalAlignment="Bottom" Margin="0,0,0,8" CornerRadius="10"
                HorizontalAlignment="Center" Background="#73000000">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Width" Value="22" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Margin" Value="3" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="Background" Value="#40FFFFFF" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="PauseBtn" Content="⏸" Click="OnPauseClick" />
                <Button x:Name="RestartBtn" Content="⟲" Click="OnRestartClick" />
                <Button x:Name="StopBtn" Content="⏹" Click="OnStopClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
