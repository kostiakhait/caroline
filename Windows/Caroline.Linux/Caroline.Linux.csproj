<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Keep the C# namespace "Caroline" (not "Caroline.Linux"): this is the
         same product as Windows/Caroline, just a different shell, not a
         conceptually separate app; matches that project's own
         "namespace Caroline;" so shared reasoning/doc comments read the same. -->
    <RootNamespace>Caroline</RootNamespace>
    <AssemblyName>Caroline</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded fallback assets (avares://Caroline/...). SplashBanners
         itself is NOT embedded, same as the WPF project: it's copied next
         to the published exe at package time (see the Makefile's Phase 5
         linux x64 target) and read from disk at AppContext.BaseDirectory,
         so a fresh set of banners doesn't need a rebuild to update. -->
    <AvaloniaResource Include="Resources\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
